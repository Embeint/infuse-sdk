# Crypto library configuration

config PSA_CRYPTO_DRIVER_OBERON
	# The Oberon driver is required to provide HKDF needed for protected storage and builtin keys
	prompt "Oberon PSA driver" if !TFM_PARTITION_PROTECTED_STORAGE
	bool
	depends on SOC_FAMILY_NORDIC_NRF
	default y
	help
	  This configuration enables the usage of the Oberon PSA driver.

config TF_PSA_CRYPTO_OBERON_ACCELERATOR
	bool "PSA crypto acceleration through the Oberon library"
	select TF_PSA_CRYPTO_EXTERNAL_ACCELERATOR_INTEGRATION
	depends on NRF_OBERON
	default y
	help
	  The integration does not attempt to accelerate every algorithm supported
	  by Oberon, only those commonly used by Infuse-IoT.

config TF_PSA_CRYPTO_CRACEN_CHACHA20_POLY1305
	bool "Accelerate ChaCha20-Poly1305 with the CRACEN CryptoMaster"
	depends on TF_PSA_CRYPTO_OBERON_ACCELERATOR
	depends on PSA_WANT_ALG_CHACHA20_POLY1305
	depends on NORDIC_CRACEN
	default y
	help
	  Run one-shot ChaCha20-Poly1305 operations on the CRACEN CryptoMaster
	  instead of the Oberon software implementation. Operations on buffers
	  that the CryptoMaster DMA cannot access continue to use Oberon. The
	  calling thread spins until the CryptoMaster completes (~1.6 cycles
	  per byte). Access to the CRACEN is synchronised by the
	  "nordic,nrf-cracen" device, see CONFIG_NORDIC_CRACEN_SYNC. The CRACEN
	  CTR size workarounds for the nRF54LM20, nRF54LV10 and nRF54LC10 only
	  apply to the AES engine and are not required for ChaCha20. Devices
	  without the BA417 engine are detected at runtime and use Oberon.

config TF_PSA_CRYPTO_CRACEN_CHACHA20_POLY1305_SW_POLY1305
	bool "Compute Poly1305 in software"
	depends on TF_PSA_CRYPTO_CRACEN_CHACHA20_POLY1305
	default y if SOC_NRF54LM20A || SOC_NRF54LM20B
	help
	  Run the CRACEN BA417 engine in plain ChaCha20 mode and compute the
	  Poly1305 authenticator in software. Required on the nRF54LM20, where
	  the combined ChaCha20-Poly1305 mode of the BA417 cannot be used.
	  Decryption where the plaintext overwrites the ciphertext falls back
	  to the Oberon implementation.

config TF_PSA_CRYPTO_CRACEN_SHA2
	bool
	default y if TF_PSA_CRYPTO_CRACEN_SHA224 || TF_PSA_CRYPTO_CRACEN_SHA256 || \
		     TF_PSA_CRYPTO_CRACEN_SHA384 || TF_PSA_CRYPTO_CRACEN_SHA512
	help
	  Common CRACEN CryptoMaster SHA-2 support. Single and multi-part
	  operations (including HMAC and HKDF) of the enabled algorithms run on
	  the hash engine, with the calling thread spinning until each hardware
	  job completes. The builtin software implementations of the enabled
	  algorithms are removed. With NORDIC_CRACEN_SYNC_SEMAPHORE, operations
	  from interrupt context fail if a thread is using the CRACEN at the time.

	  The CRACEN implementations are both faster and have a smaller ROM
	  footprint than the builtin software implementations they replace,
	  which is why each algorithm is accelerated by default.

config TF_PSA_CRYPTO_CRACEN_SHA224
	bool "Accelerate SHA-224 with the CRACEN CryptoMaster"
	depends on TF_PSA_CRYPTO_OBERON_ACCELERATOR
	depends on PSA_WANT_ALG_SHA_224
	depends on NORDIC_CRACEN
	default y
	help
	  Run SHA-224 operations on the CRACEN, see TF_PSA_CRYPTO_CRACEN_SHA2.

config TF_PSA_CRYPTO_CRACEN_SHA256
	bool "Accelerate SHA-256 with the CRACEN CryptoMaster"
	depends on TF_PSA_CRYPTO_OBERON_ACCELERATOR
	depends on PSA_WANT_ALG_SHA_256
	depends on NORDIC_CRACEN
	default y
	help
	  Run SHA-256 operations on the CRACEN, see TF_PSA_CRYPTO_CRACEN_SHA2.

config TF_PSA_CRYPTO_CRACEN_SHA384
	bool "Accelerate SHA-384 with the CRACEN CryptoMaster"
	depends on TF_PSA_CRYPTO_OBERON_ACCELERATOR
	depends on PSA_WANT_ALG_SHA_384
	depends on NORDIC_CRACEN
	default y
	help
	  Run SHA-384 operations on the CRACEN, see TF_PSA_CRYPTO_CRACEN_SHA2.
	  Enabling SHA-384 or SHA-512 increases the size of hash operation
	  contexts to hold the larger block and state.

config TF_PSA_CRYPTO_CRACEN_SHA512
	bool "Accelerate SHA-512 with the CRACEN CryptoMaster"
	depends on TF_PSA_CRYPTO_OBERON_ACCELERATOR
	depends on PSA_WANT_ALG_SHA_512
	depends on NORDIC_CRACEN
	default y
	help
	  Run SHA-512 operations on the CRACEN, see TF_PSA_CRYPTO_CRACEN_SHA2.
	  Enabling SHA-384 or SHA-512 increases the size of hash operation
	  contexts to hold the larger block and state.

config TF_PSA_CRYPTO_CRACEN_SHA3
	bool
	default y if TF_PSA_CRYPTO_CRACEN_SHA3_224 || TF_PSA_CRYPTO_CRACEN_SHA3_256 || \
		     TF_PSA_CRYPTO_CRACEN_SHA3_384 || TF_PSA_CRYPTO_CRACEN_SHA3_512
	help
	  Common CRACEN CryptoMaster SHA-3 support, see TF_PSA_CRYPTO_CRACEN_SHA2.
	  Enabling any SHA-3 algorithm increases the size of hash operation
	  contexts to hold the Keccak state.

config TF_PSA_CRYPTO_CRACEN_SHA3_224
	bool "Accelerate SHA3-224 with the CRACEN CryptoMaster"
	depends on TF_PSA_CRYPTO_OBERON_ACCELERATOR
	depends on PSA_WANT_ALG_SHA3_224
	depends on NORDIC_CRACEN
	default y
	help
	  Run SHA3-224 operations on the CRACEN, see TF_PSA_CRYPTO_CRACEN_SHA3.

