config CHARGER_AEM15820
	bool "e-peas AEM15820 energy harvesting charger"
	default y
	depends on DT_HAS_EPEAS_AEM15820_CHARGER_ENABLED
	depends on CHARGER
	select MFD
	help
	  Enable the charger child device for the e-peas AEM15820. The
	  devicetree configuration is applied to the device at boot.

config CHARGER_BQ25798
	bool "TI BQ25798 charger status"
	default y
	depends on DT_HAS_TI_BQ25798_CHARGER_ENABLED
	depends on BQ25798
	depends on CHARGER
	help
	  Enable the charger child device for the TI BQ25798. This device
	  exposes the charge status and charge type reported by the BQ25798.
