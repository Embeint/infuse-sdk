config INFUSE_IMU_ICM20689
	bool "ICM-20689 Inertial measurement unit"
	default y
	depends on DT_HAS_INVENSENSE_ICM20689_ENABLED
	select SPI
	select GPIO
	help
	  Enable driver for ICM-20689 IMU sensor
