# Infuse-IoT algorithm abstraction

config INFUSE_ALGORITHMS
	bool "Infuse-IoT algorithm abstraction"
	depends on ZBUS_CHANNEL_ID
	select INFUSE_WORKQ
	help
	  Subsystem to handle running arbitrary algorithms. Also optionally
	  includes building and packaging algorithms to be dynamically deployed
	  and loading at runtime.

if INFUSE_ALGORITHMS

config ALGORITHM_RUNNER
	bool "Infuse-IoT algorithm runner"
	default y


config ALGORITHM_LOADER
	bool "Infuse-IoT packaged algorithm loader"
	default y if LLEXT

endif # INFUSE_ALGORITHMS

rsource "loader/Kconfig"
rsource "packager/Kconfig"
rsource "runner/Kconfig"
rsource "samples/Kconfig"
