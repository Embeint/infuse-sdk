function(_validate_model_inputs
    model_dir output_h model_namespace model_c_out user_types_h_out)
  if(NOT IS_DIRECTORY "${model_dir}")
    message(FATAL_ERROR
      "MODEL_DIR must name an existing nrf_edgeai_generated model directory")
  endif()

  if("${output_h}" STREQUAL "")
    message(FATAL_ERROR "OUTPUT_H must name the generated header")
  endif()

  if(NOT "${model_namespace}" MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR
      "MODEL_NAMESPACE must be a valid C identifier: ${model_namespace}")
  endif()

  set(model_c "${model_dir}/nrf_edgeai_user_model.c")
  set(user_types_h "${model_dir}/nrf_edgeai_user_types.h")

  if(NOT EXISTS "${model_c}")
    message(FATAL_ERROR
      "Model directory does not contain nrf_edgeai_user_model.c: ${model_dir}")
  endif()

  if(NOT EXISTS "${user_types_h}")
    message(FATAL_ERROR
      "Model directory does not contain nrf_edgeai_user_types.h: ${model_dir}")
  endif()

  set("${model_c_out}" "${model_c}" PARENT_SCOPE)
  set("${user_types_h_out}" "${user_types_h}" PARENT_SCOPE)
endfunction()

# Export model macros for nrf_edgeai generated models
function(export_model_macros model_dir output_h model_namespace)
  _validate_model_inputs(
    "${model_dir}" "${output_h}" "${model_namespace}" MODEL_C USER_TYPES_H)

  add_custom_command(
    OUTPUT "${output_h}"
    COMMAND ${CMAKE_COMMAND}
      -DMODEL_DIR=${model_dir}
      -DOUTPUT_H=${output_h}
      -DMODEL_NAMESPACE=${model_namespace}
      -P ${CMAKE_CURRENT_FUNCTION_LIST_FILE}
    DEPENDS
      ${MODEL_C}
      ${USER_TYPES_H}
      ${CMAKE_CURRENT_FUNCTION_LIST_FILE}
    VERBATIM
  )
endfunction()

function(generate_model_macros model_dir output_h model_namespace)
  _validate_model_inputs(
    "${model_dir}" "${output_h}" "${model_namespace}" model_c user_types_h)

  string(TOUPPER "${model_namespace}" model_namespace_upper)

  get_filename_component(output_dir "${output_h}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")

  message(STATUS "Generating nrf edge ai model macros header at ${output_h}")

  file(WRITE "${output_h}"
    "/* Autogenerated by \n"
    " * ${CMAKE_CURRENT_LIST_FILE}\n"
    " * DO NOT EDIT\n"
    " */"
    "\n"
    "#ifndef ${model_namespace_upper}_MODEL_MACROS_H\n"
    "#define ${model_namespace_upper}_MODEL_MACROS_H\n"
    "\n"
    "#ifdef __cplusplus\n"
    "extern \"C\" {\n"
    "#endif\n"
    "\n"
  )

  file(STRINGS "${model_c}" lines
    REGEX "^[ \t]*#[ \t]*define[ \t]+(INPUT_UNIQ_FEATURES_USED_NUM|MODEL_OUTPUTS_NUM|INPUT_FEATURE_DATA_TYPE)([ \t]+.*)?$"
  )

  foreach(line IN LISTS lines)
    string(REGEX REPLACE
      "^([ \t]*#[ \t]*define[ \t]+)(INPUT_UNIQ_FEATURES_USED_NUM|MODEL_OUTPUTS_NUM|INPUT_FEATURE_DATA_TYPE)"
      "\\1${model_namespace_upper}_\\2"
      namespaced_line "${line}"
    )
    file(APPEND "${output_h}" "${namespaced_line}\n")
  endforeach()

  file(STRINGS "${user_types_h}" user_types_lines
    REGEX "^[ \t]*typedef[ \t]+(flt32_t|uint8_t|uint16_t)[ \t]+nrf_user_output_t[ \t]*;?[ \t]*$"
  )
  set(model_output_type "")

  foreach(line IN LISTS user_types_lines)
    if(line MATCHES "^[ \t]*typedef[ \t]+(flt32_t|uint8_t|uint16_t)[ \t]+nrf_user_output_t[ \t]*;?[ \t]*$")
      set(model_output_type "${CMAKE_MATCH_1}")
    endif()
  endforeach()

  if(model_output_type STREQUAL "")
    message(FATAL_ERROR
      "Could not find a supported typedef for nrf_user_output_t in ${user_types_h}")
  endif()

  if(model_output_type STREQUAL "flt32_t")
    set(model_output_macro "${model_namespace_upper}_MODEL_OUTPUT_TYPE_FLOAT")
    set(model_output_formatter "nrf_edge_ai_probability_f32")
  elseif(model_output_type STREQUAL "uint8_t")
    set(model_output_macro "${model_namespace_upper}_MODEL_OUTPUT_TYPE_Q8")
    set(model_output_formatter "nrf_edge_ai_probability_q8")
  elseif(model_output_type STREQUAL "uint16_t")
    set(model_output_macro "${model_namespace_upper}_MODEL_OUTPUT_TYPE_Q16")
    set(model_output_formatter "nrf_edge_ai_probability_q16")
  endif()

  file(APPEND "${output_h}"
   "\n"
   "#ifndef ${model_namespace_upper}_INPUT_UNIQ_FEATURES_USED_NUM\n"
   "#error \"Missing number of inputs\"\n"
   "#endif\n"
   "#ifndef ${model_namespace_upper}_MODEL_OUTPUTS_NUM\n"
   "#error \"Missing number of outputs\"\n"
   "#endif\n"
   "#ifndef ${model_namespace_upper}_INPUT_FEATURE_DATA_TYPE\n"
   "#error \"Missing input feature data type\"\n"
   "#endif\n"
   "\n"
   "#define ${model_output_macro} 1\n"
   "#define ${model_namespace_upper}_MODEL_OUTPUT_FORMATTER ${model_output_formatter}\n"
  )
  file(APPEND "${output_h}"
   "#ifdef __cplusplus\n"
   "}\n"
   "#endif\n"
   "\n"
   "#endif /* ${model_namespace_upper}_MODEL_MACROS_H */\n"
   "\n"
  )
endfunction()

if(DEFINED MODEL_DIR OR DEFINED OUTPUT_H OR DEFINED MODEL_NAMESPACE)
  if(NOT DEFINED MODEL_DIR OR NOT DEFINED OUTPUT_H OR NOT DEFINED MODEL_NAMESPACE)
    message(FATAL_ERROR
      "MODEL_DIR, OUTPUT_H and MODEL_NAMESPACE must be specified together")
  endif()

  generate_model_macros("${MODEL_DIR}" "${OUTPUT_H}" "${MODEL_NAMESPACE}")
endif()
