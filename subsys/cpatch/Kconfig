# Infuse-IoT constrained binary patching libraries

config INFUSE_CPATCH
	bool "Infuse-IoT constrained binary patching"
	depends on STREAM_FLASH
	depends on CRC

config INFUSE_CPATCH_ENCODER_SHORTEST_PATH
	bool "CPatch shortest-path encoder based patches"
	depends on INFUSE_CPATCH
	select INFUSE_CPATCH_VERSION_1
	select INFUSE_CPATCH_VERSION_2
	default y

config INFUSE_CPATCH_VERSION_1
	bool
	help
	  Original set of patching instructions

config INFUSE_CPATCH_VERSION_2
	bool
	help
	  Addition of the PATCH_DELTA instruction. This reduces patch
	  sizes by an average of 35%.

if INFUSE_CPATCH

module = CPATCH
module-str = cpatch
source "subsys/logging/Kconfig.template.log_config"

endif
