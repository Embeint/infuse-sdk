# Infuse-IoT constrained binary patching libraries

config INFUSE_CPATCH
	bool "Infuse-IoT constrained binary patching"
	depends on STREAM_FLASH
	depends on CRC

config INFUSE_CPATCH_ENCODER_SHORTEST_PATH
	bool "CPatch shortest-path encoder based patches"
	depends on INFUSE_CPATCH
	select INFUSE_CPATCH_VERSION_1
	select INFUSE_CPATCH_VERSION_2
	default y

config INFUSE_CPATCH_ENCODER_STREAM_THUMB2
	bool "CPatch stream-thumb2 encoder based patches"
	depends on INFUSE_CPATCH
	select INFUSE_CPATCH_VERSION_3
	select INFUSE_CPATCH_READ_AHEAD
	default y if ISA_THUMB2
	help
	  Patches generated by the stream-thumb2 encoder, for Cortex-M images,
	  where copies relocate the Thumb-2 branches and pointers they contain. Patches are on average
	  35% smaller than shortest-path patches using PATCH_DELTA.

config INFUSE_CPATCH_READ_AHEAD
	bool
	help
	  Read the input and patch files through 64 byte read-ahead caches,
	  reducing the number of flash reads when applying a patch. Required by
	  stream encoders, which read the patch file a byte at a time. Requires
	  an additional 144 bytes of stack while applying a patch.

config INFUSE_CPATCH_VERSION_1
	bool
	help
	  Original set of patching instructions

config INFUSE_CPATCH_VERSION_2
	bool
	help
	  Addition of the PATCH_DELTA instruction. This reduces patch
	  sizes by an average of 35%.

config INFUSE_CPATCH_VERSION_3
	bool
	help
	  Relocation preamble followed by an element stream.
	  Patch applier allocates ~1kB of static RAM as caches with default settings.

if INFUSE_CPATCH_ENCODER_STREAM_THUMB2

config INFUSE_CPATCH_STREAM_THUMB2_REGIONS_MAX
	int "Maximum pointer regions outside of the input image"
	default 4
	range 0 255
	help
	  Patches can relocate pointers into address regions outside of the
	  input image, such as RAM. Patches with more regions are rejected.
	  Each region requires 16 bytes of RAM.

config INFUSE_CPATCH_STREAM_THUMB2_MAP_INDEX_SIZE
	int "Relocation map index entries"
	default 64
	range 8 4096
	help
	  Number of relocation map entry offsets held in RAM, shared between
	  all maps of a patch. Map lookups that miss the cache read a single
	  block of ceil(entries / index size) map entries from the patch file
	  instead of binary searching the map. Each entry requires 4 bytes of
	  RAM. Must be larger than the number of maps (regions + 1). Larger
	  indices provide little benefit on real firmware updates, as the
	  index is populated from the patch file when patching starts.

config INFUSE_CPATCH_STREAM_THUMB2_MAP_CACHE_SIZE
	int "Relocation map entries cached"
	default 32
	range 1 255
	help
	  Number of recently used relocation map entries held in RAM.
	  Consecutive relocation sites tend to reference the same map entries,
	  on real firmware updates 16 entries avoid 91% of map lookups and 32
	  entries avoid 94%. Each entry requires 12 bytes of RAM.

endif # INFUSE_CPATCH_ENCODER_STREAM_THUMB2

if INFUSE_CPATCH

module = CPATCH
module-str = cpatch
source "subsys/logging/Kconfig.template.log_config"

endif
