# Build as SDK application on real hardware
configdefault INFUSE_SDK
	default y if SOC_FAMILY_NORDIC_NRF

configdefault INFUSE_REBOOT
	default y if SOC_FAMILY_NORDIC_NRF

config TEST_COAP_SERVER
	string "CoAP server to download test resources from"
	default "coap.dev.infuse-iot.com"

config TEST_COAP_SERVER_PORT
	int "CoAP server DTLS port"
	default 5684

config WIFI_SSID
	string "WiFi SSID"
	depends on WIFI
	default "TechnoCore"

config WIFI_PSK
	string "WiFi PSK"
	depends on WIFI
	default "tachyonfatline"

if !NRF_MODEM_LIB
configdefault TLS_CREDENTIALS
	default y
configdefault MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
	default y
configdefault NET_SOCKETS_SOCKOPT_TLS
	default y
configdefault NET_SOCKETS_ENABLE_DTLS
	default y
# Required PSA algorithms
configdefault PSA_WANT_ALG_TLS12_PSK_TO_MS
	default y
configdefault PSA_WANT_ALG_TLS12_PRF
	default y
endif

source "Kconfig.zephyr"
