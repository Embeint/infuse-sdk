# Build as SDK application on real hardware
configdefault INFUSE_SDK
	default y if SOC_FAMILY_NORDIC_NRF

config WIFI_SSID
	string "WiFi SSID"
	depends on WIFI
	default "test_ssid"

config WIFI_PSK
	string "WiFi PSK"
	depends on WIFI
	default "test_psk"

config TEST_SNTP_UNRESPONSIVE_SERVER
	string "SNTP server that resolves but never responds"
	default "www.google.com"
	help
	  Server written to the KV store to exercise the query timeout path.
	  The address must resolve, but SNTP queries to it must go unanswered.

source "Kconfig.zephyr"
