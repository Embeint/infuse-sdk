if SOC_FAMILY_ESPRESSIF_ESP32

configdefault UART_INTERRUPT_DRIVEN
	default y if SERIAL_ESP32_USB

configdefault SHELL_BACKEND_SERIAL_FORCE_TX_BLOCKING_MODE
	default y if SERIAL_ESP32_USB

configdefault BT_HCI_VS
	default n if BT_ESP32

configdefault NET_SOCKETS_SERVICE_STACK_SIZE
	default 2048 if WIFI_ESP32 && !NET_DHCPV4_SERVER && !(ZTEST && COVERAGE_GCOV)

# Deferred log formatting through the USB serial and ePacket backends exceeds
# the 768 byte Zephyr default on RISC-V ESP32 devices. Use 1536 bytes on all
# ESP32 devices, keeping the larger Zephyr sizes for debug, assert and coverage
# builds, which this default would otherwise override.
configdefault LOG_PROCESS_THREAD_STACK_SIZE
	default 4096 if NO_OPTIMIZATIONS
	default 2048 if ASSERT || SPIN_VALIDATE || COVERAGE_GCOV || LOG_BACKEND_FS
	default 1536

endif # SOC_FAMILY_ESPRESSIF_ESP32
