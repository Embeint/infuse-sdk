# Infuse-IoT sysbuild integration

BOARD_QUALIFIERS_LAST_THREE := $(substring,$(BOARD_QUALIFIERS),-3)

config INFUSE_INTEGRATION
	bool "Sysbuild compilation according to Infuse-IoT"

config INFUSE_INTEGRATION_BT_CTLR
	bool "Application expects infuse-bt-ctlr snippet instead of infuse"

config INFUSE_INTEGRATION_IS_NS
	bool
	default "$(BOARD_QUALIFIERS_LAST_THREE)" = "/ns"

choice BOOTLOADER
	default BOOTLOADER_NONE if INFUSE_INTEGRATION_IS_NS
	default BOOTLOADER_MCUBOOT if INFUSE_INTEGRATION
endchoice

config INFUSE_MCUBOOT_MULTITHREADING
	bool "Force multithreading on in MCUboot"
	default y
	depends on INFUSE_INTEGRATION && BOOTLOADER_MCUBOOT
	help
	  External flash drivers and USB support in MCUboot depend on
	  multithreading. Disable for internal-flash-only bootloaders to
	  reduce ROM usage.

config BT_HCI_IPC_BOARD_TARGET_CPUCLUSTER
	string
	default "cpunet" if SOC_NRF5340_CPUAPP

choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_ECDSA_P256 if SOC_FAMILY_ESPRESSIF_ESP32
endchoice
