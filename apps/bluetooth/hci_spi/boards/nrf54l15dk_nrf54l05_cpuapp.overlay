#include "nordic_sdc.dtsi"

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 1, 11)>,
				<NRF_PSEL(SPIS_MOSI, 1, 12)>,
				<NRF_PSEL(SPIS_MISO, 1, 15)>,
				<NRF_PSEL(SPIS_CSN, 1, 16)>;
		};
	};
};

&spi21 {
	compatible = "nordic,nrf-spis";
	status = "okay";
	def-char = <0x00>;
	pinctrl-0 = <&spi21_default>;
	pinctrl-names = "default";
	/delete-property/rx-delay-supported;
	/delete-property/rx-delay;

	wake-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

	hci_spi: bt-hci@0 {
		compatible = "zephyr,bt-hci-spi-slave";
		reg = <0>;
		irq-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
	};
};

/* External flash is unused */
&mx25r64 {
	status = "disabled";
};
