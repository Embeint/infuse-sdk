# Firmware update values

config INFUSE_APPLICATION_ID
	hex "Unique application identifier"
	default 0xB7000002

configdefault IMG_MANAGER
	default y

configdefault INFUSE_CPATCH
	default y if BOOTLOADER_MCUBOOT

# Reduced RAM footprint on memory constrained platforms
configdefault BT_MAX_CONN
	default 4 if SOC_NRF54L05
	default 4 if SOC_NRF52832
	default 8 if SOC_NRF52833
	default 16

configdefault BT_EXT_ADV_MAX_ADV_SET
	default 2 if SOC_NRF54L05
	default 4 if SOC_NRF52832
	default 6

# Softdevice default values

configdefault BT_CTLR_SDC_PERIPHERAL_COUNT
	default 3

configdefault BT_CTLR_SDC_SCAN_BUFFER_COUNT
	default 5

configdefault BT_CTLR_SDC_TX_PACKET_COUNT
	default 5

configdefault BT_CTLR_SDC_RX_PACKET_COUNT
	default 5

# No logging or console output on ROM constrained platforms
if SOC_NRF54L05

configdefault LOG
	default n

configdefault PRINTK
	default n

configdefault BOOT_BANNER
	default n

configdefault EARLY_CONSOLE
	default n

configdefault STDOUT_CONSOLE
	default n

endif # SOC_NRF54L05

# Channel Sounding (only available on SoCs with radio support)
configdefault BT_CTLR_CHANNEL_SOUNDING
	default y

configdefault BT_CTLR_CHANNEL_SOUNDING_TEST
	default n if SOC_NRF54L05

# Periodic Advertising with Responses (only available on supported controllers)

configdefault BT_PER_ADV
	default y if BT_CTLR_ADV_PERIODIC_RSP_SUPPORT

configdefault BT_PER_ADV_RSP
	default y if BT_CTLR_ADV_PERIODIC_RSP_SUPPORT

configdefault BT_PER_ADV_SYNC
	default y if BT_CTLR_SYNC_PERIODIC_RSP_SUPPORT

configdefault BT_PER_ADV_SYNC_RSP
	default y if BT_CTLR_SYNC_PERIODIC_RSP_SUPPORT

configdefault BT_PER_ADV_SYNC_TRANSFER_SENDER
	default y if BT_CTLR_ADV_PERIODIC_RSP_SUPPORT || BT_CTLR_SYNC_PERIODIC_RSP_SUPPORT

configdefault BT_PER_ADV_SYNC_TRANSFER_RECEIVER
	default y if BT_CTLR_SYNC_PERIODIC_RSP_SUPPORT

source "Kconfig.zephyr"
